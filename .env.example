# Copy this file to `.env` for local development.
# Do not put real secrets in GitHub.

OPENAI_API_KEY=your_api_key_here

# Optional database overrides. If omitted, the app uses data/quantum_panorama.sqlite3
# and data/quantum_research.db.
QUANTUM_PANORAMA_DB_PATH=data/quantum_panorama.sqlite3
QUANTUM_RESEARCH_DB_PATH=data/quantum_research.db

# Optional output directory reserved for generated reports.
REPORT_OUTPUT_DIR=reports/output

# Optional app environment label: development, staging, production.
APP_ENV=development

# Optional future data-source settings.
OPENALEX_EMAIL=
USPTO_API_KEY=
NEWS_API_KEY=
